# Base URL of OUR backend (the Next.js proxy), e.g. https://api.example.com
# NEVER put a Rentcast or any provider API key here — this file ships in the bundle.
EXPO_PUBLIC_API_BASE_URL=

# Demo gate, sent as the X-Demo-Key header to OUR backend. It ships in the bundle
# and is NOT a secret, just a speed bump to protect request quota. Leave blank to
# send no header. NEVER put a Rentcast or any provider API key here.
EXPO_PUBLIC_DEMO_KEY=
